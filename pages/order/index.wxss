/* pages/order/index.wxss */

page {
  background: linear-gradient(180deg, #f0f2f5 0%, #ffffff 100%);
}

.page-container {
  min-height: 100vh;
  padding: 0 0 140rpx 0;
  box-sizing: border-box;
}

.page-header {
  background: linear-gradient(135deg, #d4380d 0%, #ff7043 50%, #ff8a65 100%);
  padding: calc(constant(safe-area-inset-top) + 80rpx) 32rpx 160rpx;
  padding: calc(env(safe-area-inset-top) + 80rpx) 32rpx 160rpx;
  border-radius: 0 0 50rpx 50rpx;
  position: relative;
  box-shadow: 0 8rpx 30rpx rgba(212, 56, 13, 0.3);
}

.page-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  border-radius: 0 0 50rpx 50rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

.status-overview {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: -100rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 10;
}

.status-icon-large {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
}

.status-icon-large.pending {
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
}

.status-icon-large.shipped {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
}

.status-icon-large.completed {
  background: linear-gradient(135deg, #f6ffed 0%, #d9f7be 100%);
}

.status-text {
  flex: 1;
}

.status-main {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.status-sub {
  font-size: 24rpx;
  color: #999;
}

.card {
  margin: 120rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #d4380d 0%, #ff6b35 50%, #ff8a65 100%);
}

.card-icon-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.card-icon {
  font-size: 32rpx;
}

.card-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.info-section {
  background: #fafafa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed #e8e8e8;
}

.info-row:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.info-icon {
  width: 48rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.info-content {
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.info-value-lg {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  word-break: break-all;
}

.info-value-highlight {
  color: #d4380d;
  font-weight: 600;
}

.order-id-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.order-id-label {
  font-size: 26rpx;
  color: #999;
}

.order-id-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  flex: 1;
}

.copy-btn {
  font-size: 22rpx;
  color: #d4380d;
  background: #fff7e6;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.order-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.order-status::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-pending {
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  color: #d4380d;
}

.status-shipped {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  color: #1890ff;
}

.status-completed {
  background: linear-gradient(135deg, #f6ffed 0%, #d9f7be 100%);
  color: #52c41a;
}

.ship-notice {
  background: linear-gradient(135deg, #fff7e6 0%, #fff1d6 100%);
  border-left: 6rpx solid #fa8c16;
  border-radius: 16rpx;
}

.ship-notice-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ship-notice-icon {
  font-size: 36rpx;
}

.ship-notice-title {
  font-size: 30rpx;
  color: #d4380d;
  font-weight: bold;
}

.ship-notice-content {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 12rpx;
}

.ship-notice-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.ship-notice-text:last-child {
  margin-bottom: 0;
}

.ship-notice-time {
  color: #fa8c16;
  font-weight: 600;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #d4380d 0%, #ff6b35 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(212, 56, 13, 0.35);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(212, 56, 13, 0.25);
}

.btn-secondary {
  background: #f5f5f5;
  color: #666;
}

.btn-secondary:active {
  background: #e8e8e8;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  border-radius: 20rpx 20rpx 0 0;
  z-index: 100;
}

.bottom-btn button {
  width: 100%;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  margin: 120rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  border-radius: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-subtext {
  font-size: 24rpx;
  color: #ccc;
}

.text-center {
  text-align: center;
}

.text-muted {
  color: #999;
}

.text-lg {
  font-size: 28rpx;
}

.text-sm {
  font-size: 24rpx;
}

.mb-20 {
  margin-bottom: 16rpx;
}

.mt-10 {
  margin-top: 8rpx;
}