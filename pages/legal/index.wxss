.legal-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 80rpx;
  padding-top: calc(24rpx + constant(safe-area-inset-top) + 88rpx);
  padding-top: calc(24rpx + env(safe-area-inset-top) + 88rpx);
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.legal-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.back {
  font-size: 28rpx;
  color: #d4380d;
  padding: 8rpx 16rpx 8rpx 0;
  flex-shrink: 0;
}

.legal-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  padding-right: 72rpx;
}

.legal-update {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.legal-block {
  margin-bottom: 36rpx;
}

.legal-heading {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.legal-body {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  white-space: pre-wrap;
}
