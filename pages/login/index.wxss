/* pages/login/index.wxss */

.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #d4380d 0%, #ff6b35 50%, #ff8c42 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.logo-section {
  text-align: center;
  margin-bottom: 50rpx;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #d4380d 0%, #ff6b35 100%);
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #999;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 96rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.form-input:focus {
  background: #fff;
  border-color: #d4380d;
  box-shadow: 0 0 0 4rpx rgba(212, 56, 13, 0.1);
}

.error-text {
  font-size: 26rpx;
  color: #ff4d4f;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #fff2f0;
  border-radius: 12rpx;
}

.btn {
  width: 80%;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  margin-top: 40rpx;
  margin-left: 10%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: linear-gradient(135deg, #d4380d 0%, #ff6b35 100%);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-link {
  background: transparent;
  color: #d4380d;
  font-size: 28rpx;
  width: 80%;
  margin-left: 10%;
}

.btn-link:active {
  opacity: 0.7;
}

.mt-20 {
  margin-top: 20rpx;
}

.footer {
  text-align: center;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}
