/* pages/login/index.wxss */

page {
  height: 100%;
  overflow: hidden;
}

.page-container {
  height: 100vh;
  min-height: 100vh;
  background: linear-gradient(135deg, #d4380d 0%, #ff6b35 50%, #ff8c42 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  padding-top: calc(40rpx + constant(safe-area-inset-top));
  padding-top: calc(40rpx + env(safe-area-inset-top));
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.bg-pattern {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  opacity: 0.5;
}

.bg-veil {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  background: radial-gradient(ellipse at center, rgba(212, 56, 13, 0.08) 0%, rgba(212, 56, 13, 0.28) 100%);
}

.login-card {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.logo-section {
  text-align: center;
  margin-bottom: 50rpx;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #d4380d 0%, #ff6b35 100%);
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #999;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 96rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.form-input:focus {
  background: #fff;
  border-color: #d4380d;
  box-shadow: 0 0 0 4rpx rgba(212, 56, 13, 0.1);
}

.error-text {
  font-size: 26rpx;
  color: #ff4d4f;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #fff2f0;
  border-radius: 12rpx;
}

.btn {
  width: 80%;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  margin-top: 40rpx;
  margin-left: 10%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #d4380d 0%, #ff6b35 100%);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-link {
  background: transparent;
  color: #d4380d;
  font-size: 28rpx;
  width: 80%;
  margin-left: 10%;
}

.btn-link:active {
  opacity: 0.7;
}

.mt-20 {
  margin-top: 20rpx;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 8rpx;
}

.agree-box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #d4380d;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  box-sizing: border-box;
}

.agree-box.checked {
  background: #d4380d;
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.agree-link {
  color: #d4380d;
}

.footer {
  text-align: center;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}
